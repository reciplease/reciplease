# file: .env.example (reciplease)
# description: Example environment variables. Copy to .env.local (`make config`)
#              and fill in real values. .env.local is gitignored.

## App
PORT=4000

## Java
### JAVA_HOME=

## Maven
MAVEN_OPTS=-Xmx3200m

## Spring Boot
SERVER_PORT=4000
# Profiles: local | dev | cloud | prod
SPRING_PROFILES_ACTIVE=local

## Database (MongoDB)
# Spring Boot 4: spring.mongodb.uri <- SPRING_MONGODB_URI (renamed from
# spring.data.mongodb.uri). Put the database name in the URI path. There is no
# local data seeder — local connects to the real database.
SPRING_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?authSource=admin

## Auth (Google OIDC resource server; required when auth is enforced)
### SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=

## Docker
DOCKER_BUILDKIT=1

## GCP
### GCP_REGION=europe
### GCP_PROJECT_ID=
### GCP_DOCKER_TOKEN=

## Makefile
AWK=awk
BASH=bash
MVN=mvn
GIT=git
DOCKER=docker
COMPOSE=docker-compose
GCLOUD=gcloud
OPEN=open

## Shell
SHELL=${BASH}
