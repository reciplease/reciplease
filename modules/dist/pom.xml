<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <parent>
    <groupId>org.reciplease</groupId>
    <artifactId>parent</artifactId>
    <version>${revision}</version>
    <relativePath>../parent/pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>

  <artifactId>dist</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.reciplease</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.reciplease</groupId>
      <artifactId>web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.reciplease</groupId>
      <artifactId>database</artifactId>
    </dependency>
    <dependency>
      <groupId>org.reciplease</groupId>
      <artifactId>google-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.reciplease</groupId>
      <artifactId>open-food-facts</artifactId>
    </dependency>

    <!-- Secret Manager starter removed: secrets are now injected as Cloud Run
         env vars via set-secrets, which Spring Boot relaxed binding picks up
         automatically. The starter was interfering with MongoDB autoconfiguration
         even with secretmanager.enabled=false. -->
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/*.yml</include>
          <include>**/*.yaml</include>
          <include>**/*.properties</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <useDefaultDelimiters>true</useDefaultDelimiters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <finalName>reciplease-dist</finalName>
          <layers>
            <enabled>true</enabled>
            <configuration>${project.basedir}/src/layers.xml</configuration>
          </layers>
        </configuration>
      </plugin>
        </plugins>
  </build>
</project>